# ============================================================
# SISSO-backend -- variables de entorno.
#
# CORRIGE hallazgo CRITICO C15-01 de la Auditoria Integral N.15
# (P0): este archivo no existia. Cada variable de abajo se extrajo
# con un grep exhaustivo de "process.env." sobre src/ y scripts/,
# no de memoria ni de documentacion -- así que refleja exactamente
# lo que el codigo usa hoy, no lo que se penso que usaba.
#
# Copiar como ".env" para desarrollo local (.env esta en .gitignore
# y NUNCA debe subirse al repositorio). En Render, cada variable se
# configura en el panel de Environment del servicio, no en un
# archivo.
#
# Ver tambien: scripts/ci_verificar_env.js -- verifica en CI que
# esta lista siga sincronizada con las variables que el codigo
# realmente usa (evita que este archivo vuelva a desactualizarse
# silenciosamente).
# ============================================================

# ---------- Base de datos (obligatoria) ----------

# Cadena de conexion completa a PostgreSQL. En produccion: la
# "Connection string" que entrega Neon para el proyecto/rama
# correspondiente (incluye usuario, password, host, puerto, nombre
# de base y sslmode=require).
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd

# Desactiva SSL/TLS por completo en la conexion a PostgreSQL.
# SOLO para un Postgres efimero de pruebas (CI, o un Postgres local
# sin TLS configurado) -- ver src/db/pool.js. NUNCA definir esta
# variable en Render/produccion: Neon exige TLS y esto rompe la
# confidencialidad de datos clinicos en transito.
DB_SSL_DISABLED=false

# Si es exactamente el string 'false', desactiva la verificacion del
# certificado TLS del servidor Postgres (equivalente a
# rejectUnauthorized:false en el driver "pg"). Dejar sin definir (o
# en cualquier otro valor) en Render/produccion -- solo existe para
# depurar problemas de cadena de certificados en entornos que no son
# Neon.
DB_SSL_REJECT_UNAUTHORIZED=true

# ---------- Autenticacion / JWT (obligatorias) ----------

# Secretos HMAC para firmar tokens de acceso y de refresco. DEBEN
# ser distintos entre si, aleatorios y de al menos 32 bytes.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Duracion de cada tipo de token (formato aceptado por la libreria
# "jsonwebtoken": '15m', '7d', etc.). Opcionales -- si se omiten,
# el codigo usa 15m / 7d respectivamente.
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---------- Cifrado de secretos MFA (obligatoria) ----------

# Clave AES-256-GCM (32 bytes) usada para cifrar en reposo el
# secreto TOTP de cada usuario con MFA habilitado (ver
# src/utils/crypto.js). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRITICO: si esta clave cambia en produccion, todos los secretos
# MFA ya cifrados quedan indescifrables (los usuarios con MFA
# quedarian bloqueados). Conservarla en un gestor de secretos, nunca
# solo en la consola de Render.
MFA_ENCRYPTION_KEY=

# ---------- Arranque e instalacion (obligatorias en producción) ----------

# Secreto de un solo uso para el endpoint de "bootstrap" que crea el
# primer usuario superadmin de una instalacion nueva (ver
# authController.js). Generar un valor aleatorio largo y rotarlo /
# eliminarlo despues del primer uso si el proveedor de hosting lo
# permite.
BOOTSTRAP_SECRET=

# Secreto para el flujo de recuperacion de acceso de emergencia
# (ver authController.js). Mismo tratamiento que BOOTSTRAP_SECRET:
# aleatorio, largo, y tratado como una llave maestra.
RECOVERY_SECRET=

# ---------- Cloudinary (obligatoria si se usan evidencias/firmas) ----------

# Credenciales del "cloud" de Cloudinary usado para archivos
# privados con URLs firmadas (evidencias de accidentes, firmas
# digitales, certificados escaneados, etc.). Sin estas 3 variables,
# cualquier endpoint que genere una URL firmada de Cloudinary falla.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- PayPhone (opcional -- solo si la suscripcion de pagos esta activa) ----------

# Credenciales de la integracion de pagos recurrentes PayPhone (ver
# pagosController.js). Si se omiten, el modulo de pagos queda
# deshabilitado de forma explicita (pagosController lo detecta y
# responde en consecuencia) en vez de fallar de forma oscura.
PAYPHONE_STORE_ID=
PAYPHONE_TOKEN=

# ---------- CORS (obligatoria en producción) ----------

# Lista de origenes permitidos, separados por coma, sin espacios
# extra necesarios (se hace trim de cada uno). Ejemplo real:
#   CORS_ORIGINS=https://sisso-rdc.github.io,https://app.sisso.ec
# CRITICO: si esta variable queda vacia en produccion, el
# middleware de CORS de src/index.js NO cae en "permitir cualquier
# origen" (eso fue un hallazgo de auditoria ya corregido) -- cae en
# "rechazar todos los origenes", lo cual rompe el frontend pero es
# el lado seguro del error. Definirla siempre en Render.
CORS_ORIGINS=https://sisso-rdc.github.io

# ---------- Rate limiting (opcional) ----------

# Numero maximo de intentos de login por ventana antes de responder
# 429. Opcional -- si se omite o no es un numero valido, el codigo
# usa 20.
LOGIN_RATE_LIMIT_MAX=20

# ---------- Infraestructura general (opcional) ----------

# Puerto donde escucha el servidor Express. Render lo inyecta
# automaticamente; solo hace falta definirlo en desarrollo local si
# el 3000 esta ocupado.
PORT=3000

# 'development', 'test' o 'production'. Afecta advertencias de log,
# nunca logica de seguridad (ninguna verificacion de autorizacion
# depende de NODE_ENV).
NODE_ENV=development

# Render fija esta variable automaticamente en cada build, con el
# SHA del commit real que esta desplegando (ver
# src/utils/versionServidor.js, que la usa para el campo "version"
# de GET /api/salud -- corrige el hallazgo CRITICO C15-04). NO
# definirla a mano: Render la establece sola. En desarrollo local o
# en CI, si no esta presente, el codigo cae automaticamente a
# `git rev-parse --short HEAD`, asi que no hace falta configurar
# nada aqui para trabajar localmente.
RENDER_GIT_COMMIT=
